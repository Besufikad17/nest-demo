# WebAuthn / Passkey configuration
# WEBAUTHN_RP_ID: effective domain the credential is scoped to.
#   Development:  localhost
#   Production:   your-domain.com  (must match the host in WEBAUTHN_ORIGIN)
WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_NAME: human-readable name shown in browser prompts
WEBAUTHN_RP_NAME=nest-demo
# WEBAUTHN_ORIGIN: full origin (scheme + host + optional port) of your frontend.
#   Must be consistent with WEBAUTHN_RP_ID.
#   Development:  http://localhost:4000
#   Production:   https://your-domain.com
WEBAUTHN_ORIGIN=http://localhost:4000
